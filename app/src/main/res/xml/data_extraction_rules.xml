<?xml version="1.0" encoding="utf-8"?>
<!-- Android's automatic backup, from Android 12: the database and the settings only (ADR-0001), the same for
     the backup to the Google account and for a transfer to a new phone.
     Thumbnails are out twice over: they live in the no-backup directory, and no rule here includes files. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
